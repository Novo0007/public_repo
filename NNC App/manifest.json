{
  "manifest_version": 3,
  "name": "Chrome",
  "version": "1.0",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "stop-timer": {
      "suggested_key": {
        "default": "Alt+L"
      },
      "description": "Chrome background "
    }
  }
}